# Azure AI Foundry Configuration
# Replace these values with your actual Azure AI Foundry project details

# Your Azure AI Foundry project endpoint
# Example: https://your-project.eastus.api.azureml.ms
AZURE_AI_PROJECT_ENDPOINT=your_project_endpoint_here

# Your Azure subscription ID
AZURE_SUBSCRIPTION_ID=your_subscription_id_here

# Your Azure resource group name
AZURE_RESOURCE_GROUP=your_resource_group_here

# Your Azure AI Foundry project name
AZURE_AI_PROJECT_NAME=your_project_name_here
